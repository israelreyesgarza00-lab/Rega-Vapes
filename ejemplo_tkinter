import tkinter as tk
window = tk.Tk()
window.title("La GUI más sencilla del mundo")
label = tk.Label(text="Hola, soy una label" , bg="yellow" , fg= "blue")
label.pack()
entry = tk.Entry(relief="groove" , bg="#83e6e2")
entry.pack()
button=tk.Button(text="Pulsame")
button.pack()
window.mainloop()

def diHola():
    label["text"]="Hola"

button = tk.Button(text="Pulsame" , command = diHola())


